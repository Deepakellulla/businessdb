# Get this from @BotFather on Telegram after creating your bot
BOT_TOKEN=123456789:AAExampleTokenReplaceThis

# PostgreSQL connection string.
# Format: postgresql://user:password@host:port/dbname
# Most hosted providers (Neon, Supabase, Railway) require ?sslmode=require at the end.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Your timezone (IANA name). Controls the date stamped on entries AND when daily jobs run.
TIMEZONE=Asia/Kolkata

# Optional overrides (hours are in TIMEZONE)
REMINDER_HOUR=9
REMINDER_MINUTE=0
REMINDER_DAYS_BEFORE=3
MORNING_SUMMARY_HOUR=8        # -1 turns the morning summary off
MORNING_SUMMARY_MINUTE=0
MIN_MARGIN_PCT=10             # review screen warns below this profit margin
DEFAULT_COUNTRY_CODE=91       # prepended to 10-digit phone numbers for WhatsApp links
# WHATSAPP_MESSAGE=Hi {customer}, your {item} subscription ends on {end_date}. Want to renew?

# Optional: Google Sheets live sync. Leave both blank to skip this feature entirely.
# See README.md "Google Sheets sync" section for how to get these.
GOOGLE_SHEETS_CREDENTIALS_B64=
GOOGLE_SHEETS_SPREADSHEET_ID=
